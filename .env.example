# Compose/local PostgreSQL. Supply your own password; these values are not production secrets.
POSTGRES_DB=gather
POSTGRES_USER=gather
POSTGRES_PASSWORD=
# For running Java outside Compose, match these credentials to the database above.
DATABASE_URL=jdbc:postgresql://localhost:5432/gather
DATABASE_USERNAME=gather
DATABASE_PASSWORD=
# Generate separate random values (at least 32 bytes); never commit populated .env files.
JWT_SIGNING_SECRET=
MANAGEMENT_TOKEN=
# Local defaults. Replace with exact HTTPS origins when deploying.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Telegram bot configuration. Tokens stay on the backend.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=gather_minerva_bot
TELEGRAM_MINI_APP_SHORT_NAME=gather
# Copy public frontend settings into apps/web/.env.local for local Next.js development.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=gather_minerva_bot
NEXT_PUBLIC_TELEGRAM_MINI_APP_SHORT_NAME=gather
